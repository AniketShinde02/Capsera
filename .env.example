# ============================================
# DATABASE CONFIGURATION
# ============================================
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/capsera?retryWrites=true&w=majority

# ============================================
# AUTHENTICATION (NextAuth.js)
# ============================================
NEXTAUTH_SECRET=your-super-secret-key-here-generate-with-openssl
NEXTAUTH_URL=https://www.capsera.online

# ============================================
# SMTP EMAIL CONFIGURATION (Brevo Recommended)
# ============================================
# SMTP Server Settings
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-brevo-smtp-api-key
SMTP_FROM=noreply@capsera.online

# Admin Email - WHERE YOU WILL RECEIVE NOTIFICATIONS
ADMIN_EMAIL_RECEIVER=your-admin-email@gmail.com

# Alternative Brevo Configuration (if using multiple keys)
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_USER=your-email@example.com
BREVO_SMTP_PASS=your-brevo-api-key
BREVO_API_KEY_1=your-brevo-api-key

# ============================================
# APPLICATION CONFIGURATION
# ============================================
APP_NAME=Capsera
NEXT_PUBLIC_APP_URL=https://www.capsera.online
NODE_ENV=production

# ============================================
# AI PROVIDERS (Optional - for caption generation)
# ============================================
# OpenAI
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx

# Google Gemini
GOOGLE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxx

# ============================================
# FILE UPLOAD & STORAGE
# ============================================
# Cloudinary (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================
# RATE LIMITING & SECURITY
# ============================================
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# ============================================
# DEVELOPMENT ONLY
# ============================================
# Set to 'development' for local dev
# NODE_ENV=development
# NEXTAUTH_URL=http://localhost:3000
# NEXT_PUBLIC_APP_URL=http://localhost:3000
